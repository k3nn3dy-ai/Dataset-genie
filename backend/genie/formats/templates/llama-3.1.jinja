{#- Structural mirror of the Llama-3.1 Instruct chat template (header tokens, ipython tool role,
    single tool call per assistant turn). Not byte-identical to Meta's — it exists to reproduce the
    template's raise_exception guards offline. -#}
{{- '<|begin_of_text|>' }}
{%- if messages[0]['role'] == 'system' %}
    {%- set system_message = messages[0]['content'] | trim %}
    {%- set messages = messages[1:] %}
{%- else %}
    {%- set system_message = '' %}
{%- endif %}
{{- '<|start_header_id|>system<|end_header_id|>\n\n' }}
{%- if tools %}
    {{- 'Environment: ipython\n' }}
{%- endif %}
{{- system_message }}
{{- '<|eot_id|>' }}
{%- for message in messages %}
    {%- if message['role'] == 'system' %}
        {{- raise_exception('System message must be the first message') }}
    {%- elif message['role'] in ['user', 'assistant'] and not message.tool_calls %}
        {%- if message['content'] is none %}
            {{- raise_exception('Message content must not be null unless tool_calls are present') }}
        {%- endif %}
        {{- '<|start_header_id|>' + message['role'] + '<|end_header_id|>\n\n' }}
        {{- message['content'] | trim + '<|eot_id|>' }}
    {%- elif message.tool_calls %}
        {%- if message['role'] != 'assistant' %}
            {{- raise_exception('Only assistant messages may carry tool_calls') }}
        {%- endif %}
        {%- if message.tool_calls | length != 1 %}
            {{- raise_exception('This model only supports single tool-calls at once!') }}
        {%- endif %}
        {%- set tool_call = message.tool_calls[0].function %}
        {{- '<|start_header_id|>assistant<|end_header_id|>\n\n' }}
        {{- '{"name": "' + tool_call.name + '", "parameters": ' + tool_call.arguments + '}' }}
        {{- '<|eot_id|>' }}
    {%- elif message['role'] == 'tool' %}
        {{- '<|start_header_id|>ipython<|end_header_id|>\n\n' }}
        {{- message['content'] | string + '<|eot_id|>' }}
    {%- else %}
        {{- raise_exception('Unknown role: ' + message['role']) }}
    {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
    {{- '<|start_header_id|>assistant<|end_header_id|>\n\n' }}
{%- endif %}
