# Copy to .env (the Docker start scripts do this for you). Docker Compose passes these into the
# container; the app reads them before the keychain / secrets file. Both are optional: you can
# also paste the tokens into the Settings screen once the app is running.

# OpenRouter API key (required to generate anything): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face token with write access (only needed for "Export and push to Hub")
HF_TOKEN=

# Host port for the app (default 8765)
GENIE_PORT=8765
